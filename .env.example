# Required
GEMINI_API_KEY=your-api-key-here

# Model and server
GEMINI_MODEL=gemini-3.7-flash
PORT=3000

# Storage — SQLite file path, or ":memory:" for an ephemeral database
DB_PATH=data/quizzes.db

# Abuse and cost controls
GENERATE_LIMIT_PER_HOUR=10
API_LIMIT_PER_15MIN=300
MAX_DAILY_GENERATIONS=200
# Set to "true" only for local development
RATE_LIMIT_DISABLED=false

# Grading — minimum similarity (0-1) for a short answer to pass fuzzy matching
# before the model judge is consulted
FUZZY_MATCH_THRESHOLD=0.85

# Cost reporting on /api/metrics. Leave unset to omit cost rather than guess.
# PRICE_PER_1M_INPUT_USD=
# PRICE_PER_1M_OUTPUT_USD=

# Retry backoff base in milliseconds
BACKOFF_BASE_MS=1000

# Number of proxy hops to trust for client IPs (1 behind Render/Fly/Heroku)
TRUST_PROXY_HOPS=1

# Comma-separated origins allowed to call the API from another host.
# Leave empty: the frontend is served same-origin and needs no CORS.
ALLOWED_ORIGINS=

# Set to "silent" to disable request logging
LOG_LEVEL=info
